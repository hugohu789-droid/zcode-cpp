<!--
  Golden-data harness for zcode-cpp.

  Copies only the shaping-engine classes of the original east-mod/ime Java
  sources (read-only, never modified) into target/, compiles them together with
  GoldenDump, and runs them without Spring, MyBatis or a database.

  Default build: the original classes plus the bug fixes in src/patches/java
  (each patched file replaces the original class of the same name). This is
  what testdata/ is generated from.
  Profile "original" (-Poriginal): the unmodified original, built separately in
  target-original/.

  Usage (from the repository root):
    mvn -q -f tools/golden-java/pom.xml compile exec:java -Dexec.args="testdata"
    mvn -q -f tools/golden-java/pom.xml -Poriginal compile exec:java -Dexec.args="<dir>"
  Override the location of the Java original with -Dime.java.src=<dir>.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>zcodecpp</groupId>
    <artifactId>golden-java</artifactId>
    <version>1</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <ime.java.src>${project.basedir}/../../../ime-java/src/main/java</ime.java.src>
        <!-- variant-specific: the patch sources and the original files they replace -->
        <golden.variant.src>${project.basedir}/src/patches/java</golden.variant.src>
        <golden.replaced.1>com/zorigt/ime/letter/splice/front/FrontLikeTailOrhichE.java</golden.replaced.1>
        <golden.replaced.2>com/zorigt/ime/letter/splice/LetterSplicer.java</golden.replaced.2>
    </properties>

    <profiles>
        <profile>
            <id>original</id>
            <properties>
                <golden.variant.src>${project.basedir}/src/original/java</golden.variant.src>
                <golden.replaced.1>none</golden.replaced.1>
                <golden.replaced.2>none</golden.replaced.2>
            </properties>
            <build>
                <directory>${project.basedir}/target-original</directory>
            </build>
        </profile>
    </profiles>

    <!-- Versions follow what the original pom resolves through
         spring-boot-starter-parent 2.1.4.RELEASE (lombok, slf4j) or pins
         explicitly (guava, commons-collections). -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>23.0</version>
        </dependency>
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.2</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.26</version>
        </dependency>
        <!-- The original logs every rejected candidate at INFO; silence it. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.26</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Only the shaping engine; everything else needs Spring. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-ime-java-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/ime-java-src</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${ime.java.src}</directory>
                                    <includes>
                                        <include>com/zorigt/ime/letter/**/*.java</include>
                                        <include>com/zorigt/ime/keyboard/*.java</include>
                                        <include>com/zorigt/ime/filter/KeyFilter.java</include>
                                        <include>com/zorigt/ime/filter/BTailKeyFilter.java</include>
                                        <include>com/zorigt/ime/common/Strings.java</include>
                                    </includes>
                                    <excludes>
                                        <exclude>${golden.replaced.1}</exclude>
                                        <exclude>${golden.replaced.2}</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/ime-java-src</source>
                                <source>${golden.variant.src}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>zcodecpp.golden.GoldenDump</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
